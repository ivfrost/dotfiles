# zsh
.zshrc.local
.zsh_history
.zsh_sessions/
.zcompdump*

# package dumps must stay age-encrypted (never commit plaintext)
pkglist
pkglist.txt
*.pkglist

# sensitive local package skip list (never commit)
pkg-skip
pkg-skip.txt

# unison
.unison/*
!.unison/*.prf

# neovim / vim
packer_compiled.lua
*.swp
*.swo
*~
.*~
Session.vim
.netrwhist
tags
TAGS

# vscode
Code/
!Code/User/keybindings.json
!Code/User/settings.json
# The two negations above do not actually work - git cannot re-include a file
# whose parent directory is excluded - so those two are force-added (`git add -f`)
# and stay tracked from then on, which ignore rules never affect.

# copyq
cinnamon/.config/copyq/copyq.pub

