	"workbench.experimental.modernUI": false,
	"editor.lineNumbers": "relative",
	"editor.lightbulb.enabled": "off",
	"workbench.editor.showTabs": "multiple",
	"gitlens.mode.active": "zen",
	"vim.easymotion": true,
	"vim.leader": "<space>",
