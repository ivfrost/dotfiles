{
	"vim.disableExtension": false,
	"window.commandCenter": false,
	"workbench.layoutControl.enabled": false,
	"workbench.activityBar.location": "bottom",
	"window.menuBarVisibility": "toggle",
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.padding.top": 2,
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
	},
	"prettier.bracketSameLine": true,
	"prettier.experimentalTernaries": true,
	"prettier.singleQuote": true,
	"prettier.useTabs": true,
	"prettier.vueIndentScriptAndStyle": true,
	"github.copilot.chat.localeOverride": "en",
	"github.copilot.nextEditSuggestions.enabled": false,
	"editor.fontFamily": "BlexMono Nerd Font",
	"explorer.compactFolders": false,
	"github.copilot.nextEditSuggestions.fixes": false,
	"github.copilot.enable": {
		"*": false,
		"plaintext": false,
		"markdown": true,
		"scminput": false,
	},
	"C_Cpp.clang_format_style": "file",
	"C_Cpp.clang_format_fallbackStyle": "Google",
	"window.restoreWindows": "all",
	"window.title": "${rootName} — ${appName}",
	"prettier.tabWidth": 2,
	"python.analysis.autoImportCompletions": true,
	"python.analysis.autoFormatStrings": true,
	"python.analysis.completeFunctionParens": true,
	"python.analysis.typeCheckingMode": "basic",
	"git.openRepositoryInParentFolders": "never",
	"editor.autoClosingBrackets": "always",
	"extensions.ignoreRecommendations": true,
	"explorer.confirmDragAndDrop": false,
	"chat.fontFamily": "Adwaita Sans",
	"notebook.markup.fontFamily": "BlexMono Nerd Font",
	"markdown.preview.fontFamily": "'Adwaita Sans',  system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
	"workbench.editor.empty.hint": "hidden",
	"editor.tabSize": 2,
	"chat.viewSessions.orientation": "stacked",
	"keyboard.dispatch": "keyCode",
	"terminal.integrated.fontLigatures.enabled": false,
	"editor.fontLigatures": false,
	"window.titleBarStyle": "custom",
	"editor.renderLineHighlight": "none",
	"window.controlsStyle": "custom",
	"scm.inputFontSize": 14,
	"window.customTitleBarVisibility": "windowed",
	"window.enableMenuBarMnemonics": false,
	"workbench.editor.enablePreview": false,
	"editor.fontWeight": "400",
	"editor.lineHeight": 1.4,
	"editor.allowVariableFonts": false,
	"chat.fontSize": 14,
	"workbench.editor.closeOnFileDelete": true,
	"workbench.editor.labelFormat": "medium",
	"workbench.preferredLightColorTheme": "Light+",
	"window.autoDetectColorScheme": true,
	"editor.stickyScroll.enabled": true,
	"search.exclude": {
		"**/node_modules": true,
		"**/dist": true,
		"**/build": true,
		"**/.git": true,
	},
	"json.schemaDownload.trustedDomains": {
		"https://schemastore.azurewebsites.net/": true,
		"https://raw.githubusercontent.com/": true,
		"https://www.schemastore.org/": true,
		"https://json.schemastore.org/": true,
		"https://json-schema.org/": true,
		"https://biomejs.dev": true,
	},
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit",
		"source.fixAll.biome": "explicit",
		"source.organizeImports": "always",
		"source.fixAll.eslint": "always",
	},
	"workbench.preferredDarkColorTheme": "Dark+",
	"workbench.colorCustomizations": {
		"tab.activeBorder": "#d4d4d4",
		"tab.activeBorderTop": "#3a3a3a",
		"editorIndentGuide.background1": "#3a3a3a",
		"editorIndentGuide.activeBackground1": "#555555",
	},
	"chat.tools.global.autoApprove": false,
	"terminal.integrated.fontFamily": "BlexMono Nerd Font",
	"editor.minimap.enabled": false,
	"workbench.browser.openLocalhostLinks": false,
	"tailwindCSS.experimental.classRegex": [
		["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]* archival)[\"'`]"],
	],
	"files.associations": {
		"*.css": "tailwindcss",
		"*.scss": "tailwindcss",
	},
	"js/ts.suggest.autoImports": true,
	"editor.scrollBeyondLastColumn": 0,
	"editor.rulers": [
		{ "column": 80, "color": "#2a2a2a" },
		{ "column": 120, "color": "#2a2a2a" },
	],
	"window.zoomLevel": -0.075,
	"react-native-tools.showUserTips": false,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"editor.multiCursorModifier": "alt",
	"workbench.iconTheme": "material-icon-theme",
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"terminal.integrated.enableMultiLinePasteWarning": "never",
	"[cpp]": {
		"editor.defaultFormatter": "ms-vscode.cpptools",
	},
	"[c]": {
		"editor.defaultFormatter": "ms-vscode.cpptools",
	},
	"python.createEnvironment.trigger": "off",
	"workbench.editor.limit.value": 8,
	"workbench.editor.tabActionCloseVisibility": false,
	"breadcrumbs.enabled": false,
	"material-icon-theme.folders.theme": "specific",
	"editor.quickSuggestions": {
		"other": "on",
		"comments": false,
		"strings": false,
	},
	"editor.suggestOnTriggerCharacters": true,
	"editor.inlineSuggest.enabled": true,
	"editor.suggest.preview": true,
	"editor.tabCompletion": "off",
	"terminal.integrated.allowedLinkSchemes": [
		"file",
		"http",
		"https",
		"mailto",
		"vscode",
		"vscode-insiders",
		"utils/apiFetch.ts",
	],
	"redhat.telemetry.enabled": false,
	"terminal.integrated.commandsToSkipShell": [
		"-workbench.action.terminal.focusFind",
		"kilo-code.new.agentManagerOpen",
		"kilo-code.new.agentManager.showTerminal",
		"kilo-code.new.agentManager.previousTerminal",
		"kilo-code.new.agentManager.nextTerminal",
	],
	"C_Cpp.codeAnalysis.clangTidy.enabled": true,
	"C_Cpp.codeAnalysis.clangTidy.path": "/usr/bin/clang-tidy",
	"C_Cpp.codeAnalysis.clangTidy.useBuildPath": true,
	"editor.inlineSuggest.edits.showCollapsed": true,
	"update.showReleaseNotes": false,
	"editor.formatOnSave": true,
	"workbench.colorTheme": "Dark+",
	"chat.titleBar.openInAgentsWindow.enabled": false,
	"kilo-code.new.agentWorkStyle": "human-in-the-loop",
	"kilo-code.new.showTaskTimeline": false,
	"kilo-code.new.autoApprove.enabled": true,
	"security.workspace.trust.untrustedFiles": "open",
	"gitlens.views.scm.grouped.views": {
		"commits": true,
		"branches": true,
		"remotes": true,
		"stashes": true,
		"tags": true,
		"worktrees": true,
		"contributors": true,
		"fileHistory": false,
		"repositories": true,
		"searchAndCompare": false,
		"launchpad": true,
	},
	"chat.tools.urls.autoApprove": {
		"https://code.visualstudio.com": true,
		"https://github.com/microsoft/vscode/wiki/*": true,
		"https://docs.expo.dev": {
			"approveRequest": true,
			"approveResponse": false,
		},
	},
	"kilo-code.new.autocomplete.enableChatAutocomplete": true,
	"kilo-code.new.autocomplete.model": "codestral-2508",
	"kilo-code.new.autocomplete.provider": "mistral",
	"kilo-code.new.autocomplete.enableSmartInlineTaskKeybinding": true,
