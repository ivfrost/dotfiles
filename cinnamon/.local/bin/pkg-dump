#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.config/dotfiles}"
OUT="${PKG_OUT:-$DOTFILES/cinnamon/.config/pkglist.age}"
AGE_RECIPIENT="${AGE_RECIPIENT:-age1qq26sl9lraw893wfjkg3g2cumudjyzy3trlejd9wdqyzcdzzzv6sg3c7ks}"
# Local, sensitive file. Kept outside the repo so it is never committed.
SKIPFILE="${PKG_SKIP_FILE:-$HOME/.config/pkg-skip}"

# Keep plaintext strictly in RAM. Never write a plaintext package dump to disk.
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

NATIVE="$WORK/native"
FOREIGN="$WORK/foreign"
PLAIN="$WORK/pkglist"

mkdir -p "$(dirname "$OUT")"

echo "Dumping explicitly installed packages (plaintext only in RAM)"
pacman -Qqen > "$NATIVE"
pacman -Qqem > "$FOREIGN"

if [[ -f "$SKIPFILE" ]]; then
    echo "Applying skip list from $SKIPFILE"
    grep -vE '^\s*(#|$)' "$SKIPFILE" > "$WORK/skip" || true
    if [[ -s "$WORK/skip" ]]; then
        grep -v -F -f "$WORK/skip" "$NATIVE"  > "$WORK/native.f"  || true
        grep -v -F -f "$WORK/skip" "$FOREIGN" > "$WORK/foreign.f" || true
        mv "$WORK/native.f"  "$NATIVE"
        mv "$WORK/foreign.f" "$FOREIGN"
    fi
fi

# Two-section format so pkg-install knows which packages come from repos
# vs. the AUR (needed because pacman and paru handle them differently).
{
    echo "# native"
    cat "$NATIVE"
    echo
    echo "# foreign"
    cat "$FOREIGN"
} > "$PLAIN"

echo "Encrypting to $OUT"
age -r "$AGE_RECIPIENT" -o "$OUT" "$PLAIN"

echo "Done. native=$(wc -l < "$NATIVE"), foreign/AUR=$(wc -l < "$FOREIGN")"
